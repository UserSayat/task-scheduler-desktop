<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="modal-root" prefWidth="560" prefHeight="460"
      fx:controller="org.example.taskschedulerdesktop.shell.RejectedChangesController"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">

    <VBox styleClass="modal-body" VBox.vgrow="ALWAYS">
        <Label text="Отклонённые изменения" styleClass="modal-title"/>
        <Label text="Сервер не принял эти изменения. Они хранятся на компьютере и не отправляются, пока вы не решите, что с ними делать."
               wrapText="true" styleClass="employees-hint"/>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane-clean" VBox.vgrow="ALWAYS">
            <VBox fx:id="rowsVBox"/>
        </ScrollPane>
        <HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeButton" text="Закрыть" styleClass="btn-secondary"/>
        </HBox>
    </VBox>
</VBox>
