<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16" styleClass="content-area"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.taskschedulerdesktop.tag.TagsController">

    <TableView fx:id="tagsTable" HBox.hgrow="ALWAYS" styleClass="task-table">
        <columns>
            <TableColumn fx:id="colorColumn" prefWidth="60" text="Цвет" sortable="false"/>
            <TableColumn fx:id="nameColumn" prefWidth="260" text="Тег"/>
            <TableColumn fx:id="tasksColumn" prefWidth="100" text="Задач"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <VBox spacing="10" prefWidth="300" minWidth="280" styleClass="card">
        <Label fx:id="formTitle" text="Новый тег" styleClass="team-name"/>
        <Label text="НАЗВАНИЕ" styleClass="field-label"/>
        <TextField fx:id="nameField" promptText="backend" styleClass="text-field-styled"/>
        <Label text="ЦВЕТ" styleClass="field-label"/>
        <ColorPicker fx:id="colorPicker" maxWidth="Infinity"/>
        <Button fx:id="saveButton" text="Добавить тег" styleClass="btn-primary" maxWidth="Infinity"/>
        <HBox spacing="8">
            <Button fx:id="newButton" text="Новый тег" styleClass="btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="deleteButton" text="Удалить" styleClass="btn-ghost-danger"/>
        </HBox>
        <Label text="Создавать, менять и удалять теги может только администратор. Изменения уйдут на сервер при синхронизации."
               wrapText="true" minHeight="-Infinity" styleClass="employees-hint"/>
    </VBox>
</HBox>
