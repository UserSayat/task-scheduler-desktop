<?import javafx.scene.layout.*?>

<VBox styleClass="modal-root" prefWidth="420"
      fx:controller="org.example.taskschedulerdesktop.project.CreateProjectController"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">

<!--    TODO добавить этот блок когда создание проекта будет происходить не в диалоге, а на текущем экране (Верхний слой StackPane)-->
<!--    <VBox styleClass="modal-header" spacing="3">-->
<!--        <HBox alignment="CENTER_LEFT">-->
<!--            <Label fx:id="formSup" text="СОЗДАНИЕ" styleClass="modal-sup" HBox.hgrow="ALWAYS"/>-->
<!--            <Button fx:id="exitButton" text="×"-->
<!--                    style="-fx-background-color:transparent;-fx-text-fill:#9b9b95;-->
<!--                           -fx-font-size:18px;-fx-cursor:hand;-fx-border-width:0;"/>-->
<!--        </HBox>-->
<!--        <Label fx:id="formTitle" text="Новый проект" styleClass="modal-title"/>-->
<!--    </VBox>-->

    <VBox styleClass="modal-body">
        <Label text="НАЗВАНИЕ *" styleClass="field-label"/>
        <TextField fx:id="projectNameTextField" promptText="Название проекта"
                   styleClass="text-field-styled"/>

        <Label text="ДОСТУП" styleClass="field-label"/>
        <HBox spacing="4">
            <fx:define>
                <ToggleGroup fx:id="visibilityGroup"/>
            </fx:define>
            <ToggleButton fx:id="publicToggle" text="Открытый" styleClass="toggle-visibility"
                          toggleGroup="$visibilityGroup" selected="true"/>
            <ToggleButton fx:id="privateToggle" text="Закрытый" styleClass="toggle-visibility"
                          toggleGroup="$visibilityGroup"/>
        </HBox>
        <Label fx:id="visibilityHint" styleClass="visibility-hint" wrapText="true"/>

        <Label text="РУКОВОДИТЕЛЬ" styleClass="field-label"/>
        <ComboBox fx:id="supervisorComboBox" maxWidth="Infinity"
                  styleClass="combo-box-styled" promptText="Выбрать"/>

        <HBox spacing="8" style="-fx-padding:6 0 0 0;">
            <Button fx:id="createProjectButton" text="Создать проект" styleClass="btn-primary"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="cancelButton" text="Отмена" styleClass="btn-secondary"/>
        </HBox>
    </VBox>
</VBox>
