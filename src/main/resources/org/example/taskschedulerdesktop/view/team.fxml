<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane-clean"
            fx:controller="org.example.taskschedulerdesktop.controllers.team.TeamController"
            xmlns:fx="http://javafx.com/fxml/1">
