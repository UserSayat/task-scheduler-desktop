            <GridPane hgap="8">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>
                <VBox GridPane.columnIndex="0" styleClass="mini-stat-box" alignment="CENTER" spacing="2">
                    <Label text="2" styleClass="mini-stat-val"/>
                    <Label text="задач" styleClass="mini-stat-lbl"/>
                </VBox>
                <VBox GridPane.columnIndex="1" styleClass="mini-stat-box" alignment="CENTER" spacing="2">
