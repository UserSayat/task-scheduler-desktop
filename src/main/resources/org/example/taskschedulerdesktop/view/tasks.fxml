<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" styleClass="content-area"
      fx:controller="org.example.taskschedulerdesktop.task.TasksController"
      xmlns:fx="http://javafx.com/fxml/1">

    <!-- Поиск, выпадающие фильтры (их добавляет контроллер) и счётчик -->
    <HBox fx:id="topFilters" spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Поиск по задаче, проекту, исполнителю или тегу"
                   styleClass="task-search" HBox.hgrow="ALWAYS" maxWidth="380" minWidth="160"/>
        <Button fx:id="resetFiltersButton" text="Сбросить" styleClass="filter-reset" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="taskCountLabel" styleClass="section-mono" minWidth="-Infinity"/>
    </HBox>

    <!-- Статус и приоритет: можно выбрать несколько значений; кнопки создаёт контроллер -->
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
        <HBox fx:id="statusFilters" spacing="4" alignment="CENTER_LEFT">
            <Label text="СТАТУС" styleClass="filter-caption"/>
        </HBox>
        <Separator orientation="VERTICAL" prefHeight="20" styleClass="filter-separator"/>
        <HBox fx:id="priorityFilters" spacing="4" alignment="CENTER_LEFT">
            <Label text="ПРИОРИТЕТ" styleClass="filter-caption"/>
        </HBox>
    </FlowPane>

    <VBox fx:id="taskTableContainerVBox" VBox.vgrow="ALWAYS"/>
</VBox>
