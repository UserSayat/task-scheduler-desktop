<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minWidth="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.taskschedulerdesktop.controllers.TaskController">
   <children>
      <HBox alignment="CENTER_LEFT" maxHeight="80.0" minHeight="80.0" minWidth="0.0" prefHeight="80.0" spacing="10.0" style="-fx-background-color: #ffffff;">
         <children>
            <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="70.0">
               <children>
                  <Label text="Задачи">
                     <font>
                        <Font name="Times New Roman" size="25.0" />
                     </font>
                  </Label>
                  <Label prefHeight="18.0" prefWidth="190.0" text="воскресенье, 2 августа 2026 г." textFill="#6d6d6d">
                     <font>
                        <Font name="Arial" size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" style="-fx-background-color: #ffffff; -fx-border-color: #d4d4d4; -fx-border-width: 0.5; -fx-border-radius: 0;" text="+ Новая задача">
               <padding>
                  <Insets bottom="4.0" left="10.0" right="10.0" top="4.0" />
               </padding>
            </Button>
            <TextField promptText="Поиск задач..." />
         </children>
         <padding>
            <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
         </padding>
      </HBox>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="720.0" stylesheets="@../styles/style.css" VBox.vgrow="ALWAYS">
        <content>
          <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="30.0">
               <children>
                  <HBox alignment="CENTER_LEFT" maxHeight="80.0" minWidth="0.0">
                     <children>
                        <Label minWidth="-Infinity" text="СТАТУС" />
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="Все" textAlignment="CENTER">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="К выполнению" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="В работе" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="На проверке" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="Завершено" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Label minWidth="-Infinity" text="ПРИОРИТЕТ" />
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="Все">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="Высокий">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="Средний">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" stylesheets="@../styles/style.css" text="Низкий">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                     </children>
                  </HBox>
                  <fx:include fx:id="tasksTableContainer" source="task_table.fxml" VBox.vgrow="ALWAYS" />
               </children>
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
               </padding>
            </VBox>
        </content>
      </ScrollPane>
   </children>
</VBox>
