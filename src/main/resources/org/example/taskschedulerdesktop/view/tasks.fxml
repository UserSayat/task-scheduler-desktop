<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minWidth="0.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.taskschedulerdesktop.controllers.tasks.TasksController">
   <children>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="720.0" VBox.vgrow="ALWAYS">
        <content>
          <VBox fx:id="taskTableContainerVBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="30.0">
               <children>
                  <HBox alignment="CENTER_LEFT" maxHeight="80.0" minWidth="0.0">
                     <children>
                        <Label minWidth="-Infinity" text="СТАТУС" />
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="Все" textAlignment="CENTER">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="К выполнению" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="В работе" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="На проверке" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="Завершено" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Label minWidth="-Infinity" text="ПРИОРИТЕТ" />
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="Все">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="Высокий">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="Средний">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="tasks-status-priority-button" text="Низкий">
                           <padding>
                              <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                           </padding>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
               </padding>
            </VBox>
        </content>
      </ScrollPane>
   </children>
</VBox>
