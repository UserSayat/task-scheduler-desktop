<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Сотрудник (новый или существующий) — отдельная страница: слева данные, справа доступ -->
<VBox fx:controller="org.example.taskschedulerdesktop.admin.EmployeeDialogController"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">
    <!-- Кнопки формы: шапка окна забирает их к себе (MainController) -->
    <HBox styleClass="page-actions" spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Отмена" styleClass="btn-secondary"/>
        <Button fx:id="saveButton" text="Создать сотрудника" styleClass="btn-primary"/>
    </HBox>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane-clean" VBox.vgrow="ALWAYS">
        <VBox spacing="16" styleClass="content-area">
            <!-- Две карточки: 60% и 40% ширины, одной высоты -->
            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="60"/>
                    <ColumnConstraints percentWidth="40"/>
                </columnConstraints>
                <!-- Карточки повыше, чтобы форма не выглядела сжатой -->
                <rowConstraints>
                    <RowConstraints minHeight="340"/>
                </rowConstraints>
                <VBox styleClass="card, form-card" maxHeight="Infinity" GridPane.columnIndex="0">
                    <!-- Поля — ровной сеткой 2×2: колонки одной ширины, поля одной высоты -->
                    <GridPane hgap="16" vgap="24">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="ИМЯ *" styleClass="field-label"/>
                            <TextField fx:id="nameField" promptText="Иванов Иван" styleClass="text-field-styled"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="EMAIL *" styleClass="field-label"/>
                            <TextField fx:id="emailField" promptText="ivanov@company.ru" styleClass="text-field-styled"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="ДОЛЖНОСТЬ" styleClass="field-label"/>
                            <TextField fx:id="positionField" promptText="Backend-разработчик" styleClass="text-field-styled"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="ЧАСОВОЙ ПОЯС" styleClass="field-label"/>
                            <ComboBox fx:id="timezoneComboBox" editable="true" maxWidth="Infinity"
                                      styleClass="combo-box-styled"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <VBox styleClass="card, form-card" maxHeight="Infinity" GridPane.columnIndex="1">
                    <VBox spacing="10">
                        <Label text="РОЛИ" styleClass="field-label"/>
                        <CheckBox fx:id="adminCheckBox" text="Администратор"/>
                        <CheckBox fx:id="projectManagerCheckBox" text="Руководитель проектов"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label fx:id="passwordLabel" text="ВРЕМЕННЫЙ ПАРОЛЬ *" styleClass="field-label"/>
                        <HBox fx:id="passwordBox" spacing="8">
                            <TextField fx:id="passwordField" styleClass="text-field-styled" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="generatePasswordButton" text="Сгенерировать" styleClass="btn-secondary" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                </VBox>
            </GridPane>
        </VBox>
    </ScrollPane>
</VBox>
