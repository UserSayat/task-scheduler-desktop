<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.control.ListView?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.taskschedulerdesktop.dashboard.DashboardController">
    <!-- Страница на всю высоту окна: «Мои задачи» тянутся до низа, снизу — такой же отступ, как сверху.
         На низком окне таблица не меньше трёх строк, списки — двух карточек; не помещается — прокрутка. -->
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="scroll-pane-clean"
                VBox.vgrow="ALWAYS">
        <VBox spacing="16" styleClass="content-area">

            <!-- Статистика -->
            <GridPane hgap="12" vgap="0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                </columnConstraints>

                <!-- Всего -->
                <StackPane styleClass="card" GridPane.columnIndex="0">
                    <VBox spacing="4">
                        <Label fx:id="statAll" styleClass="stat-number" text="10"/>
                        <Label styleClass="stat-label" text="Всего задач"/>
<!--                        <Label fx:id="amountOfActiveProjectsLabel" styleClass="stat-sub" text="активных проектов: 4"/>-->
                    </VBox>
                </StackPane>

                <!-- В работе -->
                <StackPane styleClass="card" GridPane.columnIndex="1">
                    <VBox spacing="4">
                        <Label fx:id="statInProgress" styleClass="stat-number" text="3"/>
                        <Label styleClass="stat-label" text="В работе"/>
<!--                        <Label styleClass="stat-sub" text="требуют внимания"/>-->
                    </VBox>
                </StackPane>

                <!-- На проверке -->
                <StackPane styleClass="card" GridPane.columnIndex="2">
                    <VBox spacing="4">
                        <Label fx:id="statReview" styleClass="stat-number" text="2"/>
                        <Label styleClass="stat-label" text="На проверке"/>
<!--                        <Label styleClass="stat-sub" text="ожидают решения"/>-->
                    </VBox>
                </StackPane>

                <!-- Завершено -->
                <StackPane styleClass="card" GridPane.columnIndex="3">
                    <VBox spacing="4">
                        <Label fx:id="statDone" styleClass="stat-number" text="2"/>
                        <Label styleClass="stat-label" text="Завершено"/>
<!--                        <Label styleClass="stat-sub" text="за текущий спринт"/>-->
                    </VBox>
                </StackPane>
                <rowConstraints>
                    <RowConstraints/>
                </rowConstraints>
            </GridPane>

            <!-- Прогресс проектов + дедлайны -->
            <GridPane hgap="12">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="67"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                </columnConstraints>

                <!-- Прогресс проектов -->
                <VBox styleClass="card" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
                        <Label styleClass="card-title" text="Проекты"/>
                    </HBox>

                    <!-- Четыре карточки по 74, на низком окне не меньше двух (WholeRows оставляет только целые) -->
                    <ListView fx:id="projectListView" styleClass="dashboard-list-view" prefHeight="296" minHeight="148">
                    </ListView>
                </VBox>

                <!-- Дедлайны -->
                <VBox styleClass="card" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
                        <Label styleClass="card-title" text="Дедлайны"/>
                    </HBox>

                    <ListView fx:id="deadlinesListView" styleClass="dashboard-list-view" prefHeight="296" minHeight="148">
                    </ListView>

                </VBox>
                <rowConstraints>
                    <RowConstraints/>
                </rowConstraints>
            </GridPane>

            <!-- Мои задачи: незавершённые, где пользователь ответственный или соисполнитель.
                 Подпись и таблица — в одной карточке, как «Проекты» и «Дедлайны» -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 12 0;">
                    <Label text="Мои задачи" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="myTasksCount" styleClass="section-mono" text="ответственный или соисполнитель"/>
                </HBox>
                <!-- Высота задана числами (5 строк желательно, 3 минимум), а не по таблице: её укорачивает WholeRows,
                     и иначе контейнер сжимался бы вслед за ней. Свободное место — тоже таблице -->
                <VBox fx:id="taskTableContainerVBox" VBox.vgrow="ALWAYS" prefHeight="266" minHeight="174">
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
