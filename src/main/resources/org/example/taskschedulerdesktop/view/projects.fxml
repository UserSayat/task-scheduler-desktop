<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.taskschedulerdesktop.project.ProjectsController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="scroll-pane-clean">
    <VBox fx:id="projectsPage" styleClass="content-area">

        <!-- Ряд карточек по центру, карточки от его левого края; ширину и колонки подбирает
             ProjectsController (CenteredTileRows): не больше трёх в ряд -->
        <TilePane fx:id="projectsTilePane"
                  hgap="20"
                  vgap="20"
                  prefTileWidth="480"
                  prefTileHeight="316">
                <ProgressIndicator fx:id="projectsLoadingIndicator" />
        </TilePane>

    </VBox>
</ScrollPane>