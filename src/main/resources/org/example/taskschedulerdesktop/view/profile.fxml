<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Профиль — отдельная страница: данные профиля и смена пароля рядом -->
<VBox fx:controller="org.example.taskschedulerdesktop.user.ProfileController"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">
    <!-- Кнопки страницы: шапка окна забирает их к себе (MainController) -->
    <HBox styleClass="page-actions" spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="logoutButton" text="Выйти" styleClass="btn-primary"/>
    </HBox>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane-clean" VBox.vgrow="ALWAYS">
        <HBox spacing="16" styleClass="content-area">
            <VBox styleClass="card, form-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4">
                    <Label text="Профиль" styleClass="card-title"/>
                    <Label fx:id="emailLabel" styleClass="section-mono"/>
                    <Label fx:id="serverLabel" styleClass="section-mono"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="ИМЯ *" styleClass="field-label"/>
                    <TextField fx:id="nameField" styleClass="text-field-styled"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="ДОЛЖНОСТЬ" styleClass="field-label"/>
                    <TextField fx:id="positionField" styleClass="text-field-styled"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="ЧАСОВОЙ ПОЯС" styleClass="field-label"/>
                    <ComboBox fx:id="timezoneComboBox" editable="true" maxWidth="Infinity"
                              styleClass="combo-box-styled"/>
                </VBox>
                <HBox>
                    <Button fx:id="saveProfileButton" text="Сохранить профиль" styleClass="btn-primary"/>
                </HBox>
            </VBox>

            <VBox styleClass="card, form-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="Смена пароля" styleClass="card-title"/>
                <VBox spacing="5">
                    <Label text="ТЕКУЩИЙ ПАРОЛЬ" styleClass="field-label"/>
                    <PasswordField fx:id="currentPasswordField" promptText="Текущий пароль" styleClass="text-field-styled"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="НОВЫЙ ПАРОЛЬ" styleClass="field-label"/>
                    <PasswordField fx:id="newPasswordField" promptText="Не короче 8 символов"
                                   styleClass="text-field-styled"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="ЕЩЁ РАЗ" styleClass="field-label"/>
                    <PasswordField fx:id="repeatPasswordField" promptText="Новый пароль ещё раз" styleClass="text-field-styled"/>
                </VBox>
                <Label text="Пароль меняется на сервере, нужна связь. На других устройствах потребуется войти заново."
                       wrapText="true" styleClass="employees-hint"/>
                <HBox>
                    <Button fx:id="changePasswordButton" text="Сменить пароль" styleClass="btn-secondary"/>
                </HBox>
            </VBox>
        </HBox>
    </ScrollPane>
</VBox>
