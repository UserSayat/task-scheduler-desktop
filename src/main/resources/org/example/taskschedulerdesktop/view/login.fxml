<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="login-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.taskschedulerdesktop.auth.LoginController">
    <VBox styleClass="login-card" maxWidth="380" maxHeight="-Infinity" spacing="14">
        <HBox spacing="10" alignment="CENTER_LEFT" fillHeight="false">
            <!-- Иконка приложения: высота — как у подписи справа (задаёт контроллер) -->
            <ImageView fx:id="logoImage" preserveRatio="true" smooth="true">
                <Image url="@../icons/app-128.png"/>
            </ImageView>
            <VBox fx:id="logoText" spacing="2">
                <Label text="TaskHub" styleClass="login-title"/>
                <Label text="КОРПОРАТИВНЫЙ ПОРТАЛ" styleClass="field-label"/>
            </VBox>
        </HBox>

        <Label fx:id="formTitle" text="Вход в систему" styleClass="page-title">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Label>

        <VBox fx:id="loginBox" spacing="14">
        <VBox spacing="0">
            <Label text="EMAIL" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="ivanov@company.ru" styleClass="text-field-styled"/>
        </VBox>
        <VBox spacing="0">
            <Label text="ПАРОЛЬ" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" styleClass="text-field-styled"/>
        </VBox>

        <Button fx:id="loginButton" text="Войти" defaultButton="true" maxWidth="Infinity" styleClass="btn-primary"/>
        <Hyperlink fx:id="forgotLink" text="Забыли пароль?" styleClass="login-link"/>
        </VBox>

        <!-- Сброс пароля: email → код из письма и новый пароль -->
        <VBox fx:id="resetBox" spacing="14" managed="false" visible="false">
            <VBox fx:id="resetEmailBox" spacing="14">
                <Label text="Укажите email — пришлём код для сброса пароля." wrapText="true" styleClass="page-date"/>
                <VBox spacing="0">
                    <Label text="EMAIL" styleClass="field-label"/>
                    <TextField fx:id="resetEmailField" promptText="ivanov@company.ru" styleClass="text-field-styled"/>
                </VBox>
                <Button fx:id="sendCodeButton" text="Получить код" maxWidth="Infinity" styleClass="btn-primary"/>
                <Hyperlink fx:id="haveCodeLink" text="У меня уже есть код" styleClass="login-link"/>
            </VBox>
            <VBox fx:id="resetCodeBox" spacing="14" managed="false" visible="false">
                <Label text="Если адрес зарегистрирован, код отправлен на почту. Он действует 1 час."
                       wrapText="true" styleClass="page-date"/>
                <VBox spacing="0">
                    <Label text="КОД ИЗ ПИСЬМА" styleClass="field-label"/>
                    <TextField fx:id="resetCodeField" styleClass="text-field-styled"/>
                </VBox>
                <VBox spacing="0">
                    <Label text="НОВЫЙ ПАРОЛЬ" styleClass="field-label"/>
                    <PasswordField fx:id="newPasswordField" promptText="Не короче 8 символов" styleClass="text-field-styled"/>
                </VBox>
                <VBox spacing="0">
                    <Label text="ПОВТОРИТЕ ПАРОЛЬ" styleClass="field-label"/>
                    <PasswordField fx:id="repeatPasswordField" styleClass="text-field-styled"/>
                </VBox>
                <Button fx:id="resetButton" text="Сменить пароль" maxWidth="Infinity" styleClass="btn-primary"/>
            </VBox>
            <Hyperlink fx:id="backToLoginLink" text="← Вернуться ко входу" styleClass="login-link"/>
        </VBox>

        <!-- Временный пароль от администратора нужно сменить сразу после входа -->
        <VBox fx:id="changeBox" spacing="14" managed="false" visible="false">
            <Label text="Пароль выдал администратор. Придумайте свой — после этого откроется приложение."
                   wrapText="true" styleClass="page-date"/>
            <VBox spacing="0">
                <Label text="НОВЫЙ ПАРОЛЬ" styleClass="field-label"/>
                <PasswordField fx:id="firstPasswordField" promptText="Не короче 8 символов" styleClass="text-field-styled"/>
            </VBox>
            <VBox spacing="0">
                <Label text="ПОВТОРИТЕ ПАРОЛЬ" styleClass="field-label"/>
                <PasswordField fx:id="firstRepeatField" styleClass="text-field-styled"/>
            </VBox>
            <Button fx:id="firstChangeButton" text="Сохранить и продолжить" maxWidth="Infinity" styleClass="btn-primary"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="login-error" wrapText="true" managed="false" visible="false"/>
        <Label fx:id="infoLabel" styleClass="login-info" wrapText="true" managed="false" visible="false"/>

        <HBox fx:id="progressBox" spacing="8" alignment="CENTER_LEFT" managed="false" visible="false">
            <ProgressIndicator prefWidth="16" prefHeight="16"/>
            <Label fx:id="progressLabel" styleClass="page-date"/>
        </HBox>

        <Label fx:id="serverLabel" styleClass="page-date"/>
    </VBox>
</StackPane>
