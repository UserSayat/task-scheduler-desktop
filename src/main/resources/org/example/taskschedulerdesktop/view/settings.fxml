<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Настройки в духе «Системных настроек» macOS: группы на всю ширину, в строке слева иконка,
  название и подсказка, справа — элемент управления. Иконки — Bootstrap Icons (MIT).
-->
<VBox styleClass="settings-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.taskschedulerdesktop.settings.SettingsController">

    <ScrollPane fitToWidth="true" styleClass="scroll-pane-clean" VBox.vgrow="ALWAYS">
        <VBox styleClass="settings-content" spacing="6">

            <!-- Даты -->
            <Label text="ДАТЫ" styleClass="settings-header"/>
            <VBox styleClass="settings-group">
                <HBox styleClass="settings-row" spacing="12">
                    <StackPane styleClass="settings-icon, settings-icon-blue">
                        <SVGPath styleClass="settings-glyph"
                                 content="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Формат даты" styleClass="settings-title"/>
                        <Label fx:id="dateExampleLabel" styleClass="settings-subtitle"/>
                    </VBox>
                    <ComboBox fx:id="dateFormatComboBox" styleClass="combo-box-styled, settings-control"/>
                </HBox>
            </VBox>
            <Label text="Полные даты и поля ввода дат. В списках остаются короткие даты («18 сен»)."
                   wrapText="true" styleClass="settings-footnote"/>

            <!-- Сотрудники -->
            <Label text="СОТРУДНИКИ" styleClass="settings-header"/>
            <VBox styleClass="settings-group">
                <HBox styleClass="settings-row" spacing="12">
                    <StackPane styleClass="settings-icon, settings-icon-teal">
                        <SVGPath styleClass="settings-glyph"
                                 content="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Часовой пояс по умолчанию" styleClass="settings-title"/>
                        <Label text="Подставляется при создании нового сотрудника" styleClass="settings-subtitle"/>
                    </VBox>
                    <ComboBox fx:id="timezoneComboBox" editable="true" styleClass="combo-box-styled, settings-control"/>
                </HBox>
            </VBox>

            <!-- Синхронизация -->
            <Label text="СИНХРОНИЗАЦИЯ" styleClass="settings-header"/>
            <VBox styleClass="settings-group">
                <HBox styleClass="settings-row" spacing="12">
                    <StackPane styleClass="settings-icon, settings-icon-purple">
                        <SVGPath styleClass="settings-glyph"
                                 content="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Интервал синхронизации" styleClass="settings-title"/>
                        <Label text="Как часто приложение само обменивается данными с сервером, секунд" styleClass="settings-subtitle"/>
                    </VBox>
                    <Spinner fx:id="intervalSpinner" styleClass="settings-control-small"/>
                </HBox>
                <!-- Разделитель начинается от текста, как в списках macOS -->
                <Region styleClass="settings-separator">
                    <VBox.margin><Insets left="54"/></VBox.margin>
                </Region>
                <HBox styleClass="settings-row" spacing="12">
                    <StackPane styleClass="settings-icon, settings-icon-amber">
                        <SVGPath styleClass="settings-glyph"
                                 content="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Изменений за одну отправку" styleClass="settings-title"/>
                        <Label text="Сколько изменений уходит на сервер одним запросом" styleClass="settings-subtitle"/>
                    </VBox>
                    <Spinner fx:id="batchSpinner" styleClass="settings-control-small"/>
                </HBox>
            </VBox>
            <Label text="Интервал — от 30 до 3600 секунд, изменений за отправку — от 10 до 500."
                   wrapText="true" styleClass="settings-footnote"/>
        </VBox>
    </ScrollPane>

    <!-- Нижняя панель: подсказка и кнопки, активные только при изменениях -->
    <HBox styleClass="settings-footer" spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="Настройки действуют для всех сотрудников. Сохраняются на сервере — нужна связь."
               wrapText="true" styleClass="settings-footnote" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Region HBox.hgrow="NEVER"/>
        <Button fx:id="revertButton" text="Отменить" styleClass="btn-secondary"/>
        <Button fx:id="saveButton" text="Сохранить" styleClass="btn-primary"/>
    </HBox>
</VBox>
