<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="globalStackPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
           minHeight="600.0" minWidth="900.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.taskschedulerdesktop.shell.MainController">
    <BorderPane>
        <left>
            <VBox styleClass="sidebar">
                <!-- Логотип -->
                <VBox styleClass="sidebar-logo-box">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <StackPane styleClass="logo-icon">
                            <Label text="TF" style="-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:bold;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="TaskFlow" styleClass="logo-text"/>
                            <Label text="КОРПОРАТИВНЫЙ ПОРТАЛ" styleClass="logo-sub"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Навигация -->
                <VBox VBox.vgrow="ALWAYS">
                    <Label text="НАВИГАЦИЯ" styleClass="nav-section-label"/>
                    <Button fx:id="reviewButton" text="Обзор" maxWidth="Infinity"
                            styleClass="nav-btn, nav-btn"/>
                    <Button fx:id="tasksButton" text="Задачи" maxWidth="Infinity"
                            styleClass="nav-btn"/>
                    <Button fx:id="projectsButton" text="Проекты" maxWidth="Infinity"
                            styleClass="nav-btn"/>
                    <Button fx:id="teamButton" text="Команда" maxWidth="Infinity"
                            styleClass="nav-btn"/>
                    <Button fx:id="employeesButton" text="Сотрудники" maxWidth="Infinity"
                            styleClass="nav-btn" visible="false" managed="false"/>
                    <Button fx:id="tagsButton" text="Теги" maxWidth="Infinity"
                            styleClass="nav-btn" visible="false" managed="false"/>
                    <Button fx:id="settingsButton" text="Настройки" maxWidth="Infinity"
                            styleClass="nav-btn" visible="false" managed="false"/>

<!--                    <Label text="ПРОЕКТЫ" styleClass="nav-section-label"/>-->
<!--                    <Button text="● Редизайн портала"-->
<!--                            maxWidth="Infinity" styleClass="nav-project-btn"/>-->
<!--                    &lt;!&ndash;                                onAction="#showProjects"/>&ndash;&gt;-->
<!--                    <Button text="● Миграция CRM"-->
<!--                            maxWidth="Infinity" styleClass="nav-project-btn"/>-->
<!--                    &lt;!&ndash;                                onAction="#showProjects"/>&ndash;&gt;-->
<!--                    <Button text="● Мобильное приложение"-->
<!--                            maxWidth="Infinity" styleClass="nav-project-btn"/>-->
<!--                    &lt;!&ndash;                                onAction="#showProjects"/>&ndash;&gt;-->
<!--                    <Button text="● Отчётность Q3"-->
<!--                            maxWidth="Infinity" styleClass="nav-project-btn"/>-->
<!--                    &lt;!&ndash;                                onAction="#showProjects"/>&ndash;&gt;-->
                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- Пользователь -->
                <HBox fx:id="userBox" styleClass="sidebar-user-box" spacing="10" alignment="CENTER_LEFT">
                    <StackPane styleClass="avatar-box-rm">
                        <Label fx:id="userInitialsLabel" text="—" styleClass="avatar-text"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="userNameLabel" text="Пользователь" styleClass="user-name"/>
                        <Label fx:id="userPositionLabel" styleClass="user-role"/>
                    </VBox>
                    <Button fx:id="logoutButton" text="Выйти" styleClass="logout-btn"/>
                </HBox>
            </VBox>
        </left>

        <center>
            <VBox>
                <!-- Хедер -->
                <HBox styleClass="topbar" spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="backButton" styleClass="page-back-button" mnemonicParsing="false" text="← Назад"/>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="pageTitleLabel" text="Обзор" styleClass="page-title"/>
                        <Label fx:id="pageDate"  styleClass="page-date"/>
                    </VBox>
                    <Button fx:id="notificationsButton" styleClass="bell-btn">
                        <graphic>
                            <HBox spacing="4" alignment="CENTER">
                                <SVGPath styleClass="bell-icon"
                                         content="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/>
                                <Label fx:id="unreadBadge" styleClass="bell-badge" visible="false" managed="false"/>
                            </HBox>
                        </graphic>
                        <tooltip><Tooltip text="Уведомления"/></tooltip>
                    </Button>
                    <Button fx:id="syncStatusButton" styleClass="sync-indicator" text="● Синхронизация"/>
                    <Button fx:id="createTaskButton" text="+ Новая задача"
                            styleClass="btn-secondary"/>
                    <!--                        <TextField fx:id="searchField" promptText="Поиск задач..."-->
                    <!--                                   styleClass="search-field"/>-->
                </HBox>

                <!-- Динамическая область -->
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:#f6f6f4;"/>
            </VBox>
        </center>
    </BorderPane>
</StackPane>