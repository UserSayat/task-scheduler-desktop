<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="modal-root" prefWidth="480"
      fx:controller="org.example.taskschedulerdesktop.controllers.tasks.CreateTaskController"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">

<!--    TODO добавить этот блок когда создание задачи будет происходить не в диалоге, а на текущем экране (Верхний слой StackPane)   -->
<!--    <VBox styleClass="modal-header" spacing="3">-->
<!--        <HBox alignment="CENTER_LEFT">-->
<!--            <Label text="СОЗДАНИЕ" styleClass="modal-sup" HBox.hgrow="ALWAYS"/>-->
<!--            <Button fx:id="exitButton" text="×"-->
<!--                    style="-fx-background-color:transparent;-fx-text-fill:#9b9b95;-->
<!--                           -fx-font-size:18px;-fx-cursor:hand;-fx-border-width:0;"/>-->
<!--        </HBox>-->
<!--        <Label text="Новая задача" styleClass="modal-title"/>-->
<!--    </VBox>-->

    <VBox styleClass="modal-body">
        <Label text="НАЗВАНИЕ *" styleClass="field-label"/>
        <TextField fx:id="taskNameTextField" promptText="Что нужно сделать?"
                   styleClass="text-field-styled"/>

        <HBox spacing="12">
            <VBox HBox.hgrow="ALWAYS" spacing="5">
                <Label text="ПРОЕКТ" styleClass="field-label"/>
                <ComboBox fx:id="projectComboBox" maxWidth="Infinity"
                          styleClass="combo-box-styled"
                          promptText="Выбрать проект"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="5">
                <Label text="ИСПОЛНИТЕЛЬ" styleClass="field-label"/>
                <ComboBox fx:id="executorComboBox" maxWidth="Infinity"
                          styleClass="combo-box-styled"
                          promptText="Назначить"/>
            </VBox>
        </HBox>

        <HBox spacing="12">
            <VBox HBox.hgrow="ALWAYS" spacing="5">
                <Label text="ПРИОРИТЕТ" styleClass="field-label"/>
                <HBox spacing="4">
                    <ToggleButton fx:id="tHigh"   text="Высокий"
                                  styleClass="toggle-high"/>
                    <ToggleButton fx:id="tMedium" text="Средний"
                                  styleClass="toggle-medium" selected="true"/>
                    <ToggleButton fx:id="tLow"    text="Низкий"
                                  styleClass="toggle-low"/>
                </HBox>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="5">
                <Label text="СРОК" styleClass="field-label"/>
                <DatePicker fx:id="deadlineDatePicker" maxWidth="Infinity"
                            styleClass="date-picker-styled"/>
            </VBox>
        </HBox>

        <Label text="ТЕГИ" styleClass="field-label"/>
        <TextField fx:id="tagsTextField"
                   promptText="backend, дизайн — через запятую"
                   styleClass="text-field-styled"/>

        <HBox spacing="8" style="-fx-padding:6 0 0 0;">
            <Button fx:id="createTaskButton" text="Создать задачу" styleClass="btn-primary"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="cancelButton" text="Отмена" styleClass="btn-secondary"/>
        </HBox>
    </VBox>
</VBox>
