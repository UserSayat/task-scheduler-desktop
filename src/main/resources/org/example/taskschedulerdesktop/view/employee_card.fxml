<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="team-card" spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.taskschedulerdesktop.team.EmployeeCardController">
   <HBox spacing="12" alignment="CENTER_LEFT">
      <StackPane styleClass="avatar-box-lg">
         <Label fx:id="avatarLabel" text="—" styleClass="avatar-text"/>
      </StackPane>
      <VBox spacing="2">
         <Label fx:id="employeeNameLabel" styleClass="team-name"/>
         <Label fx:id="employeePositionLabel" styleClass="team-role"/>
      </VBox>
   </HBox>
   <GridPane hgap="8">
      <columnConstraints>
         <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
         <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
      </columnConstraints>
      <VBox GridPane.columnIndex="0" styleClass="mini-stat-box" alignment="CENTER" spacing="2">
         <Label fx:id="openTasksLabel" text="0" styleClass="mini-stat-val"/>
         <Label text="в работе" styleClass="mini-stat-lbl"/>
      </VBox>
      <VBox GridPane.columnIndex="1" styleClass="mini-stat-box" alignment="CENTER" spacing="2">
         <Label fx:id="doneTasksLabel" text="0" styleClass="mini-stat-val"/>
         <Label text="готово" styleClass="mini-stat-lbl"/>
      </VBox>
   </GridPane>
   <VBox fx:id="topTasksVBox" spacing="5"/>
</VBox>
