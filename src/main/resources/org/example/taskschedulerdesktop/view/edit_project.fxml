<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="modal-root" prefWidth="540"
      fx:controller="org.example.taskschedulerdesktop.project.EditProjectController"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">

    <VBox styleClass="modal-body">
        <Label text="НАЗВАНИЕ *" styleClass="field-label"/>
        <TextField fx:id="projectNameTextField" promptText="Название проекта"
                   styleClass="text-field-styled"/>

        <Label text="РУКОВОДИТЕЛЬ" styleClass="field-label"/>
        <ComboBox fx:id="supervisorComboBox" maxWidth="Infinity"
                  styleClass="combo-box-styled" promptText="Выбрать"/>

        <Label text="УЧАСТНИКИ" styleClass="field-label"/>
        <VBox fx:id="membersVBox" spacing="6"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="newMemberComboBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                      styleClass="combo-box-styled" promptText="Добавить сотрудника"/>
            <ComboBox fx:id="newMemberRoleComboBox" prefWidth="150" styleClass="combo-box-styled"/>
            <Button fx:id="addMemberButton" text="Добавить" styleClass="btn-secondary"/>
        </HBox>

        <Label text="ОПИСАНИЕ" styleClass="field-label"/>
        <TextArea fx:id="descriptionTextArea" wrapText="true" prefRowCount="3"
                  promptText="Цели и границы проекта" styleClass="text-area-styled"/>

        <Label text="ВИДИМОСТЬ" styleClass="field-label"/>
        <ComboBox fx:id="visibilityComboBox" maxWidth="Infinity" styleClass="combo-box-styled"/>

        <HBox spacing="12">
            <VBox HBox.hgrow="ALWAYS" spacing="5">
                <Label text="НАЧАЛО" styleClass="field-label"/>
                <DatePicker fx:id="startDatePicker" maxWidth="Infinity"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="5">
                <Label text="СРОК" styleClass="field-label"/>
                <DatePicker fx:id="deadlinePicker" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <HBox spacing="8" style="-fx-padding:6 0 0 0;">
            <Button fx:id="saveProjectButton" text="Сохранить проект" styleClass="btn-primary"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="cancelButton" text="Отмена" styleClass="btn-secondary"/>
        </HBox>
    </VBox>
</VBox>
