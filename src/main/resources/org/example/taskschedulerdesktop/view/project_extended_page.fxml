<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.taskschedulerdesktop.controllers.ProjectExtendedPageController">
   <children>
      <VBox minWidth="0.0">
         <children>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="720.0" stylesheets="@../styles/style.css" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <content>
                  <VBox minWidth="0.0" spacing="20.0">
                     <children>
                        <VBox spacing="20.0">
                           <children>
                              <HBox spacing="20.0">
                                 <children>
                                    <VBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label fx:id="projectNameLabel" text="Редизайн портала">
                                             <font>
                                                <Font size="27.0" />
                                             </font>
                                          </Label>
                                          <Label fx:id="projectSupervisorLabel" text="Руководитель: А.К." />
                                       </children>
                                    </VBox>
                                    <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER">
                                       <children>
                                          <Label fx:id="numberOfTasksLabel" text="18">
                                             <font>
                                                <Font size="25.0" />
                                             </font>
                                          </Label>
                                          <Label text="Задач" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER">
                                       <children>
                                          <Label fx:id="completedTasksLabel" text="13">
                                             <font>
                                                <Font size="25.0" />
                                             </font>
                                          </Label>
                                          <Label text="Завершено" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER">
                                       <children>
                                          <Label fx:id="remainingTasksLabel" text="5">
                                             <font>
                                                <Font size="25.0" />
                                             </font>
                                          </Label>
                                          <Label text="Осталось" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER">
                                       <children>
                                          <Label fx:id="percentOfCompletionLabel" text="72%">
                                             <font>
                                                <Font size="25.0" />
                                             </font>
                                          </Label>
                                          <Label text="Прогресс" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <ProgressBar maxWidth="1.7976931348623157E308" progress="0.0" />
                           </children>
                        </VBox>
                        <HBox>
                           <children>
                              <VBox>
                                 <children>
                                    <Label text="В РАБОТЕ" />
                                    <VBox fx:id="tasksInProgressVBox" />
                                    <Label text="НА ПРОВЕРКЕ" />
                                    <VBox fx:id="tasksUnderReviewVBox" />
                                    <Label text="ЗАВЕРШЕНО" />
                                    <VBox fx:id="completedTasksVBox" />
                                 </children>
                              </VBox>
                              <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox spacing="20.0">
                                       <children>
                                          <Label text="Участники" />
                                          <HBox alignment="CENTER" spacing="20.0">
                                             <children>
                                                <Label text="АК" />
                                                <VBox HBox.hgrow="ALWAYS">
                                                   <children>
                                                      <Label text="Алексей" />
                                                      <Label text="2 задачи" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </HBox>
                                          <HBox alignment="CENTER" spacing="20.0">
                                             <children>
                                                <Label text="ИФ" />
                                                <VBox HBox.hgrow="ALWAYS">
                                                   <children>
                                                      <Label text="Ирина" />
                                                      <Label text="1 задача" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </HBox>
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
      <ProgressIndicator fx:id="loadingIndicator" visible="false" StackPane.alignment="CENTER" />
   </children>
</StackPane>
