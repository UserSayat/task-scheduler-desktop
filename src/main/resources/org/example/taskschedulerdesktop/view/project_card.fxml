<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      fx:id="rootVBox"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.taskschedulerdesktop.controllers.projects.ProjectCardController"
      styleClass="project-card"
      prefWidth="400"
      spacing="16">

   <HBox spacing="12">
      <VBox spacing="4" HBox.hgrow="ALWAYS">
         <HBox spacing="8" alignment="CENTER_LEFT">
            <Region fx:id="colorDot" styleClass="project-card-dot"/>
            <Label fx:id="projectNameLabel"
                   text="Редизайн портала"
                   styleClass="project-card-title"/>
         </HBox>
         <Label fx:id="projectSupervisorLabel"
                text="Руководитель: А.К."
                styleClass="project-card-lead"/>
      </VBox>

      <VBox alignment="TOP_RIGHT" spacing="2">
         <Label fx:id="percentOfCompletionLabel"
                text="72%"
                styleClass="project-card-percent"/>
         <Label text="выполнено"
                styleClass="project-card-percent-label"/>
      </VBox>
   </HBox>

   <ProgressBar fx:id="taskCompletionProgressBar"
                progress="0.72"
                maxWidth="Infinity"
                styleClass="project-card-progress"/>

   <HBox spacing="24">
      <VBox spacing="2">
         <Label text="Задач" styleClass="project-card-stat-label"/>
         <Label fx:id="numberOfTasksLabel" text="18" styleClass="project-card-stat-value"/>
      </VBox>
      <VBox spacing="2">
         <Label text="Завершено" styleClass="project-card-stat-label"/>
         <Label fx:id="completedTasksLabel" text="13" styleClass="project-card-stat-value"/>
      </VBox>
      <VBox spacing="2">
         <Label text="Осталось" styleClass="project-card-stat-label"/>
         <Label fx:id="remainingTasksLabel" text="5" styleClass="project-card-stat-value"/>
      </VBox>
   </HBox>

   <VBox fx:id="tasksList" spacing="6">
      <!-- Заполняется из контроллера -->
   </VBox>

   <Label text="Открыть проект →"
          styleClass="project-card-link"/>
</VBox>