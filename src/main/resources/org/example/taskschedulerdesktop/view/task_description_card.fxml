<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.taskschedulerdesktop.controllers.TaskDescriptionCardController">
   <children>
      <Label fx:id="taskSequenceNumberLabel" text="01" />
      <Label fx:id="taskNameLabel" text="Оптимизация загрузки приложений" />
      <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
      <Label fx:id="taskTypeLabel" alignment="CENTER" text="frontend">
         <font>
            <Font size="10.0" />
         </font>
      </Label>
      <Label fx:id="taskDeadlineLabel" alignment="CENTER" text="06 авг">
         <font>
            <Font size="10.0" />
         </font>
      </Label>
      <Label fx:id="executorInitialsLabel" alignment="CENTER" text="АК">
         <font>
            <Font size="10.0" />
         </font>
      </Label>
      <Label fx:id="priorityLabel" alignment="CENTER" text="Средний">
         <font>
            <Font size="10.0" />
         </font>
      </Label>
   </children>
   <padding>
      <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
   </padding>
</HBox>
