            </VBox>
            <VBox>
               <children>
                  <Label text="ПРИОРИТЕТ" />
                  <Label fx:id="priorityLabel" text="Средний" />
               </children>
            </VBox>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets left="25.0" right="25.0" />
         </padding>
      </HBox>
      <VBox>
         <children>
            <Label text="ИСПОЛНИТЕЛЬ" />
