            <Insets left="25.0" right="25.0" />
         </padding>
      </VBox>
      <VBox>
         <children>
            <Label text="ТЕГИ" />
            <FlowPane fx:id="tagsFlowPane">
               <children>
                  <Label text="frontend" />
                  <Label text="performance" />
               </children>
            </FlowPane>
         </children>
         <padding>
            <Insets left="25.0" right="25.0" />
         </padding>
      </VBox>
      <VBox maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS">
         <children>
            <Label text="ОПИСАНИЕ" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS">
               <content>
                  <Label fx:id="taskDescriptionLabel" maxHeight="1.7976931348623157E308" text="Задача в рамках проекта «Редизайн портала». Требует координации с командой и соответствия установленным срокам. Приоритет: средний." wrapText="true" />
               </content>
            </ScrollPane>
         </children>
         <padding>
            <Insets left="25.0" right="25.0" />
