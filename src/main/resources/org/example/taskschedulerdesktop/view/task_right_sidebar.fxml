<VBox maxHeight="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" spacing="20.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.taskschedulerdesktop.controllers.TaskRightSidebarController">
   <children>
      <HBox>
         <children>
            <VBox prefHeight="70.0" spacing="10.0">
               <children>
                  <Label fx:id="projectNameLabel" text="РЕДИЗАЙН ПОРТАЛА" />
                  <Label fx:id="taskNameLabel" prefWidth="305.0" text="Оптимизация загрузки приложений" wrapText="true">
                     <font>
                        <Font name="Times New Roman" size="20.0" />
                     </font></Label>
               </children>
            </VBox>
            <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            <Button fx:id="closeButton" alignment="CENTER_RIGHT" mnemonicParsing="false" text="x" />
         </children>
         <VBox.margin>
            <Insets left="25.0" right="25.0" top="20.0" />
         </VBox.margin>
      </HBox>
      <Region prefHeight="1.0" style="-fx-background-color: #000;" />
      <HBox spacing="150.0">
         <children>
            <VBox>
               <children>
                  <Label text="СТАТУС" />
                  <Label fx:id="statusLabel" text="В работе" />
