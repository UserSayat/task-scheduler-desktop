               <children>
                  <Label text="Алексей Козлов" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </FlowPane>
         </children>
         <padding>
            <Insets left="25.0" right="25.0" />
         </padding>
      </VBox>
      <VBox>
         <children>
            <Label text="ДЕДЛАЙН" />
            <Label fx:id="deadlineLabel" text="06 авг" />
