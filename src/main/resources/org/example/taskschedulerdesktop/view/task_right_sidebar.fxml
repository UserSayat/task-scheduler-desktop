         </children>
         <padding>
            <Insets left="25.0" right="25.0" />
         </padding>
      </HBox>
      <StackPane alignment="TOP_LEFT">
         <children>
            <Button fx:id="deleteButton" mnemonicParsing="false" text="Удалить задачу" />
