<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="content-area"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.taskschedulerdesktop.admin.EmployeesController">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Поиск по имени или email"
                   styleClass="search-field" HBox.hgrow="ALWAYS" maxWidth="360"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="+ Сотрудник" styleClass="btn-primary"/>
    </HBox>

    <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS" styleClass="task-table">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="200" text="Имя"/>
            <TableColumn fx:id="emailColumn" prefWidth="200" text="Email"/>
            <TableColumn fx:id="positionColumn" prefWidth="170" text="Должность"/>
            <TableColumn fx:id="rolesColumn" prefWidth="200" text="Роли"/>
            <TableColumn fx:id="statusColumn" prefWidth="150" minWidth="140" text="Статус"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="editButton" text="Изменить" styleClass="btn-secondary"/>
        <Button fx:id="blockButton" text="Заблокировать" styleClass="btn-secondary"/>
        <Button fx:id="resetPasswordButton" text="Сбросить пароль" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Изменения сохраняются на сервере — нужна связь" styleClass="employees-hint"/>
        <Button fx:id="deleteButton" text="Удалить" styleClass="btn-ghost-danger"/>
    </HBox>
</VBox>
