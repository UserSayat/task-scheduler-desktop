<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Журналы — в папке пользователя рядом с локальной базой: установленное приложение
         не может писать в свою папку в Program Files. Другая папка: -Dtaskhub.logDir=... -->
    <property name="LOG_DIR" value="${taskhub.logDir:-${user.home}/.taskschedulerdb/logs}"/>

    <!-- ============================================================
    ВЫВОД В КОНСОЛЬ (цветной)
    ============================================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--
                %d{HH:mm:ss.SSS} - время
                %highlight - цветной уровень логирования
                %cyan - голубой цвет для имени логгера
                %msg - сообщение
                %n - перевод строки
            -->
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{0}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ============================================================
    ВЫВОД В ФАЙЛ (с ротацией)
    ============================================================ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>

        <!-- Политика ротации: каждый день новый файл -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory> <!-- Хранить 7 дней -->
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ============================================================
    НАСТРОЙКИ УРОВНЕЙ ЛОГИРОВАНИЯ
    ============================================================ -->

    <!-- Логи нашего приложения: в разработке DEBUG, в установленном приложении INFO
         (уровень задаётся при сборке установщика: -Dtaskhub.logLevel=INFO) -->
    <logger name="org.example.taskschedulerdesktop" level="${taskhub.logLevel:-DEBUG}"/>

    <!-- Логи самой JavaFX (менее важные) -->
    <logger name="javafx" level="WARN"/>

    <!-- Логи H2 (база данных) -->
    <logger name="org.h2" level="WARN"/>

    <!-- Корневой логгер (по умолчанию WARN) -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>