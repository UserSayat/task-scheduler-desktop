<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>task-scheduler-desktop</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>task-scheduler-desktop</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <jackson.version>2.18.2</jackson.version>

        <!-- Сборка приложения для Windows (jpackage), см. README -->
        <app.name>TaskHub</app.name>
        <app.version>1.0.4</app.version>
        <!-- Адрес сервера, вшиваемый в приложение: mvn package -Dtaskhub.server.url=https://... -->
        <taskhub.server.url>http://localhost:8080</taskhub.server.url>
        <!-- app-image — папка с программой; профили installer (.msi) и mac-installer (.dmg) — установщики -->
        <jpackage.type>app-image</jpackage.type>
        <!-- Параметры jpackage для конкретной системы (задаются профилями ниже) -->
        <jpackage.platform.args></jpackage.platform.args>
        <!-- Значок: .ico для Windows, .icns для macOS (выбирается по системе, где идёт сборка) -->
        <app.icon>${project.basedir}/icon.ico</app.icon>
        <!-- Где лежит WiX Toolset 3 (нужен только для .msi) -->
        <wix.dir>${user.home}/tools/wix314</wix.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.15</version>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>13.12.0</version>
        </dependency>

        <!-- JSON для обмена с сервером -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- UUID v7 -->
        <dependency>
            <groupId>com.github.f4b6a3</groupId>
            <artifactId>uuid-creator</artifactId>
            <version>6.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1. Компилятор проекта -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

            <!-- Запуск из IDE и терминала: mvn javafx:run (флаги — через -Djavafx.args или jvmArgs ниже) -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>org.example.taskschedulerdesktop.MainLauncher</mainClass>
                </configuration>
            </plugin>

            <!-- Запуск тестов JUnit 5 (встроенная версия surefire их не видит) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>

            <!-- 2. Плагин копирования зависимостей (Добавляем его) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <!-- Копируем все JAR-библиотеки (включая JavaFX) в target/libs -->
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Плагин сборки .exe через нативный jpackage -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Перед копированием зависимостей очищаем папку: иначе после обновления
                         библиотеки в сборку попадут и старая, и новая версия -->
                    <execution>
                        <id>clean-jpackage-input</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/libs"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jpackage-execution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- jpackage не перезаписывает готовую сборку — убираем прошлую -->
                                <delete dir="${project.build.directory}/dist"/>
                                <mkdir dir="${project.build.directory}/dist"/>

                                <!-- Копируем сам собранный JAR приложения в общую папку к зависимостям, чтобы jpackage всё увидел в одном месте -->
                                <copy file="${project.build.directory}/task-scheduler-desktop-1.0-SNAPSHOT.jar"
                                      todir="${project.build.directory}/libs"/>

                                <exec executable="${java.home}/bin/jpackage" failonerror="true">
                                    <!-- WiX нужен jpackage только для .msi -->
                                    <env key="PATH" path="${wix.dir}${path.separator}${env.PATH}"/>
                                    <arg value="--type"/>
                                    <arg value="${jpackage.type}"/>
                                    <arg value="--name"/>
                                    <arg value="${app.name}"/>
                                    <arg value="--app-version"/>
                                    <arg value="${app.version}"/>
                                    <arg value="--vendor"/>
                                    <arg value="TaskHub"/>
                                    <arg value="--description"/>
                                    <arg value="TaskHub - corporate task planner"/>
                                    <!-- Установщик собирается в кодировке 1252: в его текстах только латиница -->
                                    <!-- Адрес сервера и уровень журнала для установленного приложения -->
                                    <arg value="--java-options"/>
                                    <arg value="-Dtaskhub.server=${taskhub.server.url}"/>
                                    <arg value="--java-options"/>
                                    <arg value="-Dtaskhub.logLevel=INFO"/>
                                    <arg line="${jpackage.platform.args}"/>

                                    <arg value="--input"/>
                                    <arg path="${project.build.directory}/libs"/>
                                    <arg value="--main-jar"/>
                                    <arg value="task-scheduler-desktop-1.0-SNAPSHOT.jar"/>
                                    <arg value="--main-class"/>
                                    <arg value="org.example.taskschedulerdesktop.MainLauncher"/>

                                    <arg value="--dest"/>
                                    <arg path="${project.build.directory}/dist"/>

                                    <arg value="--icon"/>
                                    <arg path="${app.icon}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Установщик для Windows: mvn package -Pinstaller -Dtaskhub.server.url=https://...
             Результат — target/dist/TaskHub-1.0.0.msi. Нужен WiX Toolset 3 (см. README). -->
        <profile>
            <id>installer</id>
            <properties>
                <jpackage.type>msi</jpackage.type>
                <!-- Ярлыки в «Пуске» и на рабочем столе (при установке — галочки, создавать ли их), выбор папки;
                     один и тот же upgrade-uuid, чтобы новая версия ставилась поверх старой, а не рядом -->
                <jpackage.platform.args>--win-menu --win-menu-group TaskHub --win-shortcut --win-shortcut-prompt --win-dir-chooser --win-upgrade-uuid 07e8e4cd-907d-4e09-8655-07f69f917d76</jpackage.platform.args>
            </properties>
        </profile>

        <!-- Установщик для macOS: mvn package -Pmac-installer -Dtaskhub.server.url=https://...
             Собирается только на Mac (jpackage не собирает для другой системы); результат —
             target/dist/TaskHub-1.0.0.dmg для того процессора, на котором шла сборка
             (Apple Silicon или Intel). Приложение не подписано: при первом запуске macOS
             попросит подтвердить открытие (правый щелчок → «Открыть»). -->
        <profile>
            <id>mac-installer</id>
            <properties>
                <jpackage.type>dmg</jpackage.type>
                <jpackage.platform.args>--mac-package-name TaskHub --mac-package-identifier org.example.taskhub</jpackage.platform.args>
            </properties>
        </profile>

        <!-- На Mac значок приложения — .icns; включается сам, если сборка идёт на macOS -->
        <profile>
            <id>mac-icon</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <app.icon>${project.basedir}/icon.icns</app.icon>
            </properties>
        </profile>
    </profiles>
</project>